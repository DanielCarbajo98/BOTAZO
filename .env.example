# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Scheduler
TIMEZONE=Europe/Madrid
DAILY_REPORT_HOUR=9
DAILY_REPORT_MINUTE=0

# Logging
LOG_LEVEL=INFO

# Optional: football-data.org API key (free tier).
# Get one at https://www.football-data.org/client/register
# Used as primary source for fixtures since FBref blocks datacenter IPs.
FOOTBALL_DATA_API_KEY=

# Optional: The Odds API key (free tier 500 req/month).
# Get one at https://the-odds-api.com/
# Without this the value detector cannot run; the daily report will only
# list fixtures with model probabilities and no picks.
ODDS_API_KEY=
