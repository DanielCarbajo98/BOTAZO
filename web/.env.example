# ---------------------------------------------------------------------------
# Obligatorio en producción
# ---------------------------------------------------------------------------

# Clave para firmar sesiones y tokens. Genérala con:  openssl rand -base64 48
AUTH_SECRET=

# URL pública del sitio, sin barra final. Se usa en los enlaces que enviamos.
NEXT_PUBLIC_SITE_URL=https://alisio.es

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------

# Ruta del fichero SQLite. Relativa al directorio de la app o absoluta.
# En Railway/Fly apunta a un volumen persistente, p. ej. /data/alisio.db
DATABASE_PATH=data/alisio.db

# Aviso instantáneo de nuevas solicitudes por Telegram.
# Crea el bot con @BotFather y obtén tu chat_id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternativa (o añadido): webhook genérico para Slack, Discord, n8n, Make…
NOTIFY_WEBHOOK_URL=

# --- Cobro del desbloqueo -------------------------------------------------
# Sin estas claves el cobro es manual: el cliente paga por Bizum o
# transferencia y tú lo marcas como pagado desde el panel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Datos que se le enseñan al cliente cuando el cobro es manual.
PAGO_BIZUM=
PAGO_IBAN=
PAGO_TITULAR=
